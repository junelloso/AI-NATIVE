{
  "_readme": "Copy this to settings.local.json and update paths. settings.local.json is gitignored — never commit it.",
  "mcpServers": {
    "obsidian-docs": {
      "command": "mcp-server-filesystem",
      "args": [
        "/REPLACE/WITH/YOUR/PATH/TO/AI-NATIVE/vault"
      ],
      "_examples": {
        "macOS": "/Users/yourname/repos/AI-NATIVE/vault",
        "Linux": "/home/yourname/repos/AI-NATIVE/vault",
        "Windows": "C:/Users/yourname/repos/AI-NATIVE/vault"
      }
    },
    "project-code": {
      "command": "mcp-server-filesystem",
      "args": [
        "/REPLACE/WITH/YOUR/PATH/TO/AI-NATIVE"
      ]
    },
    "postgres-db": {
      "_disabled": true,
      "_enable_when": "Phase 1 — PostgreSQL created. Remove _disabled key to activate.",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_CONNECTION_STRING": "postgresql://user:password@localhost:5432/ai_native_db"
      }
    },
    "github": {
      "_disabled": true,
      "_enable_when": "Phase 1 — Replace token with your GitHub PAT. Remove _disabled key to activate.",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_REPLACE_WITH_YOUR_TOKEN"
      }
    }
  }
}

# =============================================================================
# AI-NATIVE Platform — Environment Variables Template
# =============================================================================
# Copy to .env and fill in values for local development.
# NEVER commit .env — it is in .gitignore.
# In production, all secrets come from HashiCorp Vault via External Secrets Operator.
# =============================================================================

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
LOG_LEVEL=DEBUG                              # DEBUG | INFO | WARNING | ERROR

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                                # Increase in staging/prod

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# Get your API key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_TIMEOUT_SECONDS=60

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_native_dev
POSTGRES_USER=ai_native
POSTGRES_PASSWORD=CHANGE_ME_local_dev_only
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_local_dev_only
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_local_dev_only
QDRANT_COLLECTION_KNOWLEDGE_BASE=knowledge-base
QDRANT_COLLECTION_USER_CONTEXT=user-context

# ─── Observability (OpenTelemetry) ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-native-api
OTEL_ENVIRONMENT=development
OTEL_TRACES_SAMPLER=always_on                # parentbased_traceidratio in prod

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
# Note: NEXT_PUBLIC_ vars are exposed to the browser — never put secrets here

# ─── AWS (local dev only — in prod use IRSA, never static keys) ──────────────
# AWS_ACCESS_KEY_ID=REPLACE_FOR_LOCAL_DEV_ONLY
# AWS_SECRET_ACCESS_KEY=REPLACE_FOR_LOCAL_DEV_ONLY
# AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=ai-native-dev-assets

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AI_AGENT_ENABLED=true
FEATURE_AUTO_HEAL_ENABLED=false              # Enable in staging+
FEATURE_AUTO_LEARN_ENABLED=false             # Enable in staging+
